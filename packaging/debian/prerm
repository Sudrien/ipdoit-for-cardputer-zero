#!/bin/sh
set -e
# On removal, take the live My network rules out of ufw. The templates in /etc/ipdoit-for-cardputer-zero stay
# until purge, so reinstalling brings them back.
if [ "$1" = "remove" ] && [ -x /usr/lib/ipdoit-for-cardputer-zero/ipdoit-helper ]; then
    /usr/lib/ipdoit-for-cardputer-zero/ipdoit-helper clear-mynet >/dev/null 2>&1 || true
fi
# Remove the opt-in NetworkManager hook link, but only if it points at our script.
P=ipdoit-for-cardputer-zero
if [ "$1" = "remove" ]; then
    link=/etc/NetworkManager/dispatcher.d/90-$P
    if [ -L "$link" ] && [ "$(readlink "$link")" = "/usr/lib/$P/nm-dispatcher" ]; then
        rm -f "$link"
    fi
fi
exit 0

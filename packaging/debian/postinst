#!/bin/sh
set -e
# 0.1.0 shipped the template's /etc/template-app.conf, which every app from the
# template also ships; remove it (kept as .dpkg-bak if it was edited).
dpkg-maintscript-helper rm_conffile /etc/template-app.conf 0.1.1~ -- "$@"
if [ "$1" = "configure" ]; then
    mkdir -p /etc/ipdoit /var/lib/ipdoit/backups
    chmod 755 /etc/ipdoit
    chmod 700 /var/lib/ipdoit
    # Bring My network rules in line with the current network (no-op on first install).
    /usr/libexec/ipdoit/ipdoit-helper sync >/dev/null 2>&1 || true
fi
exit 0
